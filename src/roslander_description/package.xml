<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roslander_description</name>
  <version>0.1.0</version>
  <description>Minimal ROSLander model, arena and Gazebo launcher.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>Apache-2.0</license>

  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>roslander_gazebo_plugins</exec_depend>
  <exec_depend>roslander_sensors</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
