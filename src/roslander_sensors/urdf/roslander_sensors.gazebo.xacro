<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Base-mounted Orbbec Astra depth camera. -->
  <gazebo reference="astra_camera_link">
    <sensor name="astra_depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </camera>
      <plugin name="roslander_astra_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>astra_camera/image_raw:=astra_camera/rgb/image_raw</remapping>
          <remapping>astra_camera/camera_info:=astra_camera/rgb/camera_info</remapping>
          <remapping>astra_camera/depth/image_raw:=astra_camera/depth/image_raw</remapping>
          <remapping>astra_camera/depth/camera_info:=astra_camera/depth/camera_info</remapping>
          <remapping>astra_camera/points:=astra_camera/depth_registered/points</remapping>
        </ros>
        <camera_name>astra_camera</camera_name>
        <frame_name>depth_cam_frame</frame_name>
        <min_depth>0.10</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Installed S2 lidar usable sector is about 97 degrees forward. -->
  <gazebo reference="lidar_sim_frame">
    <sensor name="s2_lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>509</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.846485</min_angle>
            <max_angle>0.846485</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="roslander_s2_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_sim_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="roslander_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="roslander_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
</robot>
